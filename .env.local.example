# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose this to the browser or commit it. Used only in
# server actions/routes to create faculty accounts via the Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
